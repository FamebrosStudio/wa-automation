# WhatsApp Cloud API
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
GRAPH_API_VERSION=v19.0
PORT=3000

# Business info (optional overrides)
BUSINESS_NAME=Famebros Studio
BUSINESS_PHONE=+91 98923 84424
BUSINESS_EMAIL=growth@famebrosstudio.com
BUSINESS_ADDRESS=Mulund West, Mumbai - 400080
WHATSAPP_LINK=https://wa.me/919892384424

# Firestore lead/conversation storage (server-side Firebase Admin SDK)
FIREBASE_PROJECT_ID=wa-automation-famebros-phase-1
# Preferred on Vercel: reuse the WIF settings below; grant that service account
# roles/datastore.user on the Firebase project. No private key is required.
# Optional legacy/local fallback only; never commit credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Dashboard Basic Auth
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Google Workload Identity Federation for Firestore (no private key)
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
